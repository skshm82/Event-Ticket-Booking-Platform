# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/event-tickets?retryWrites=true&w=majority

# Upstash Redis connection string (native protocol)
REDIS_URL=rediss://<username>:<password>@<region>.upstash.io:6379

# Client URL for CORS (development)
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000

# Node environment
NODE_ENV=development
